<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <%- include('partials/flash') %>

            <form action="/edit-organization/<%= organization.organization_id %>" method="POST">
                <div class="form-group">
                    <label for="name">Organization Name</label>
                    <input type="text" id="name" name="name" value="<%= organization.name %>" required minlength="3"
                        maxlength="150" />
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" required
                        maxlength="500"><%= organization.description %></textarea>
                </div>

                <div class="form-group">
                    <label for="contactEmail">Contact Email</label>
                    <input type="email" id="contactEmail" name="contactEmail" value="<%= organization.contact_email %>"
                        required />
                </div>

                <button type="submit">Update Organization</button>
                <a href="/organization/<%= organization.organization_id %>">Cancel</a>
            </form>

    </main>
    <%- include('partials/footer') %>