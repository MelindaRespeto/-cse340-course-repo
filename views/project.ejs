<%- include('partials/header') %>
    <%- include('partials/flash') %>

        <h2>
            <%= project.title %>
        </h2>
        <p><a href="/edit-project/<%= project.project_id %>">Edit this project</a></p>
        <p><strong>Organization:</strong>
            <%= project.organization_name %>
        </p>
        <p>
            <%= project.description %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>
        <p><strong>Date:</strong>
            <%= project.project_date.toLocaleDateString() %>
        </p>

        <p><strong>Categories:</strong></p>
        <% if (categories.length===0) { %>
            <p>No categories assigned yet.</p>
            <% } else { %>
                <ul class="tag-list">
                    <% categories.forEach((category)=> { %>
                        <li>
                            <a href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </li>
                        <% }); %>
                </ul>
                <% } %>

                    <p><a href="/projects">&larr; Back to all projects</a></p>

                    <%- include('partials/footer') %>