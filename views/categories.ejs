<%- include('partials/header') %>

    <h2>
        <%= title %>
    </h2>

    <%- include('partials/flash') %>

        <ul class="item-list">
            <% categories.forEach((category)=> { %>
                <li>
                    <h3>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </h3>
                </li>
                <% }); %>
        </ul>

        <p><a href="/new-category">Add a new category</a></p>

        <%- include('partials/footer') %>