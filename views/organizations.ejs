<%- include('partials/header') %>

    <h2>
        <%= title %>
    </h2>

    <div class="card-grid">
        <% organizations.forEach((organization)=> { %>
            <div class="card">
                <img src="<%= organization.image %>" alt="<%= organization.name %> logo">
                <h3>
                    <%= organization.name %>
                </h3>
            </div>
            <% }); %>
    </div>

    <%- include('partials/footer') %>